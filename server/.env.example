# Copy this file to .env and fill in your own values. Never commit .env.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Replace YOUR_PASSWORD with the postgres password you set when installing PostgreSQL.
# If your password has special characters like @ # or /, tell Claude - they need encoding.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/kuruman_marketplace

# Set to true later when we move to an online (hosted) database.
DATABASE_SSL=false

# AI category assistant (the Python service in ai/). Use the same random token in both places.
AI_SERVICE_URL=http://127.0.0.1:5001
AI_SERVICE_TOKEN=change-me-to-a-long-random-string

# Encrypts support staff authenticator secrets in the database: 32 random bytes in base64.
# Make one (from the server folder) with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Payfast SANDBOX (test money only). "Pay online" stays switched off until these are set.
# Create a free sandbox account at https://sandbox.payfast.co.za, then copy its Merchant ID
# and Merchant Key and set a passphrase under Settings > Developer Settings.
# (The shared public test merchant's passphrase is not reliable - anyone can change it.)
# PAYFAST_SANDBOX=true
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# Where the customer's browser returns to after paying.
PUBLIC_APP_URL=http://localhost:5173
# Payfast's servers must be able to reach this. localhost is NOT reachable from the internet -
# use a tunnel URL here (see docs/DEMO_SCRIPT.md), and set TRUST_PROXY=1 (one proxy: the tunnel).
# PAYFAST_NOTIFY_URL=https://your-tunnel.trycloudflare.com/api/payments/payfast/notify
# TRUST_PROXY=1

# Sign-in codes by SMS. No gateway connected yet: codes go to the server log, and with this on
# they are also shown on screen (demo only). On by default on a laptop, off by default when hosted.
SMS_DEMO_SHOW_CODES=true

# Photos. Leave empty to keep photos in the database (fine on a laptop). Hosted: the value from the
# Cloudinary dashboard, cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Replies from sellers' phones: the SMS gateway calls /api/sms/inbound?token=THIS (16+ random characters).
SMS_INBOUND_TOKEN=

# Real SMS through BulkSMS (leave empty on a laptop: SMS are then only logged).
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=

# Free calls over data through Twilio (leave empty to hide the "Call free" buttons).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
