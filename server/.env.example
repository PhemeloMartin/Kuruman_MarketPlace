# Copy this file to .env and fill in your own values. Never commit .env.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Replace YOUR_PASSWORD with the postgres password you set when installing PostgreSQL.
# If your password has special characters like @ # or /, tell Claude - they need encoding.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/kuruman_marketplace

# Set to true later when we move to an online (hosted) database.
DATABASE_SSL=false

# AI category assistant (the Python service in ai/). Use the same random token in both places.
AI_SERVICE_URL=http://127.0.0.1:5001
AI_SERVICE_TOKEN=change-me-to-a-long-random-string
